rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
                      (request.auth.uid == userId && 
                        (request.resource.data.role == 'teacher' || 
                        (request.resource.data.role == 'admin' && request.auth.token.email == 'nhelland@nbend.k12.or.us'))
                      ) || 
                      isAdmin()
                    );
      allow update: if isAuthenticated() && (
                      (request.auth.uid == userId && 
                        (request.resource.data.role == resource.data.role || 
                        (request.resource.data.role == 'admin' && request.auth.token.email == 'nhelland@nbend.k12.or.us'))
                      ) || 
                      isAdmin()
                    );
      allow delete: if isAuthenticated() && (
                      isAdmin() || 
                      (resource.data.isPlaceholder == true && resource.data.email == request.auth.token.email)
                    );
    }

    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isTeacher() || isAdmin());
      allow update: if isAuthenticated() && (isTeacher() || isAdmin());
    }

    match /passes/{passId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isTeacher() || isAdmin());
      allow update: if isAuthenticated() && (isTeacher() || isAdmin());
    }
  }
}
