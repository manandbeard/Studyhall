# ─────────────────────────────────────────────────────────────
# API Server — environment variables
# Copy this file to .env and fill in the real values.
# ─────────────────────────────────────────────────────────────

# Firebase Admin SDK project (required)
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=

# Admin user's email address (required to gate the /gemini/* routes)
ADMIN_EMAIL=

# Gemini AI API key (required for /api/gemini/* routes)
GEMINI_API_KEY=

# Comma-separated list of allowed CORS origins.
# Leave unset to allow all origins (useful behind a reverse proxy).
# Example: https://app.example.com,https://mobile.example.com
CORS_ORIGIN=

# Pino log level (default: info)
LOG_LEVEL=info
