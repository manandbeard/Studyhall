# ─────────────────────────────────────────────────────────────
# Study Hall Mobile — environment variables
# Copy this file to .env and fill in the real values.
# Variables prefixed with EXPO_PUBLIC_ are exposed to the app bundle.
# ─────────────────────────────────────────────────────────────

# Firebase project configuration (required)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIRESTORE_DATABASE_ID=

# School domain used to gate login (defaults to nbend.k12.or.us)
EXPO_PUBLIC_SCHOOL_DOMAIN=

# Email address of the admin user (required for admin access)
EXPO_PUBLIC_ADMIN_EMAIL=

# Google OAuth client IDs (required for sign-in)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Base URL of the API server, e.g. https://myapp.replit.app (no trailing slash)
EXPO_PUBLIC_API_BASE_URL=
