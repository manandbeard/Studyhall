# ─────────────────────────────────────────────────────────────
# Study Hall Tracker — environment variables
# Copy this file to .env and fill in the real values.
# Variables prefixed with VITE_ are exposed to the browser bundle.
# ─────────────────────────────────────────────────────────────

# Firebase project configuration (required)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIRESTORE_DATABASE_ID=

# School domain used to gate login (defaults to nbend.k12.or.us)
VITE_SCHOOL_DOMAIN=

# Email address of the admin user (required for admin access)
VITE_ADMIN_EMAIL=
